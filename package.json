{
  "name": "@utilarium/unplayable",
  "version": "0.0.32-dev.0",
  "description": "A cross-platform audio recording and processing library",
  "type": "module",
  "main": "./dist/unplayable.cjs",
  "module": "./dist/unplayable.js",
  "types": "./dist/unplayable.d.ts",
  "bin": {
    "unplayable": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobrien/unplayable.git"
  },
  "exports": {
    ".": {
      "types": "./dist/unplayable.d.ts",
      "import": "./dist/unplayable.js",
      "require": "./dist/unplayable.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run lint && tsc --noEmit && vite build",
    "start": "dist/main.js",
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "test": "vitest run --coverage",
    "precommit": "npm run lint && npm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "docs:dev": "cd docs && cp ../README.md public/ && npm install && npm run dev",
    "docs:build": "cd docs && cp ../README.md public/ && npm install && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "docs:test": "cd docs && npm install && npm run test",
    "docs:coverage": "cd docs && npm install && npm run coverage"
  },
  "keywords": [
    "audio",
    "recording",
    "microphone",
    "ffmpeg",
    "cross-platform"
  ],
  "author": "Tim O'Brien <tobrien@discursive.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@utilarium/cardigantime": "^0.0.27",
    "commander": "^14.0.3",
    "glob": "^14.0.4",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-replace": "^6.0.3",
    "@swc/core": "^1.16.22",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "wrap-ansi": "7.0.0"
  }
}
